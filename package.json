{
  "name": "eduboard",
  "version": "0.7.9",
  "description": "A local-first teacher dashboard for tracking students, classes, lesson plans, grades, attendance, and reports across K-12, university, and club sections.",
  "main": "./out/main/index.js",
  "author": "Purysho",
  "license": "AGPL-3.0-only",
  "desktopName": "eduboard.desktop",
  "homepage": "https://github.com/purysho/EduBoard",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac -c.npmRebuild=true",
    "build:linux": "npm run build && electron-builder --linux",
    "version": "node -e \"require('fs').writeFileSync('portal/desktop-version.json', JSON.stringify({ version: require('./package.json').version }, null, 2) + '\\n')\" && git add portal/desktop-version.json",
    "error-codes": "node --experimental-strip-types --no-warnings tools/error-codes/write.mjs",
    "course-bundle": "node tools/course-bundle/create.mjs",
    "size:report": "node tools/package-size/report.mjs out",
    "size:check": "node tools/package-size/report.mjs out --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "date-fns": "^4.1.0",
    "docx": "^9.7.2",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.2",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^2.15.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "pptxgenjs": {
      "image-size": "^2.0.4"
    }
  }
}
