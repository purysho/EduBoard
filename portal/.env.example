# Copy to portal/.env on the Portal server and replace every placeholder.
# Never commit portal/.env.
SESSION_SECRET=replace-with-a-long-random-secret
SYNC_SECRET=replace-with-a-different-long-random-secret
ADMIN_SECRET=replace-with-a-third-long-random-secret
PORT=4790
NODE_ENV=production

# Optional:
# PORTAL_DATA_DIR=portal/data
# HOST=127.0.0.1
# PORTAL_TIMEZONE=Asia/Shanghai
# HOMEPAGE_HOSTS=edu-board.com,www.edu-board.com
# PORTAL_HOST=portal.edu-board.com
